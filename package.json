{
  "name": "dsh-coserwiki-reminder",
  "version": "1.0.0",
  "description": "CoserWiki 漫展提醒：在 DSH 里一屏浏览 coserwiki 漫展活动、按城市筛选，关注喜欢的 Coser 达人；他们参演的活动会自动标注「关注」，并在开始前 1 个月 / 1 周各弹窗提醒一次。关注名单可在插件设置里修改。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "coserwiki",
    "cosplay",
    "漫展",
    "reminder",
    "convention",
    "events",
    "notify",
    "fan"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "license": "MIT"
}
